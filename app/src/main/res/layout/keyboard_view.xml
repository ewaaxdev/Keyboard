<?xml version="1.0" encoding="utf-8"?>
<!-- Halaman huruf ala iPhone: background abu terang, tombol putih/abu.
     Tombol dikenali service lewat tag (huruf = tag 1 huruf). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#D1D4DA"
    android:padding="3dp">

    <!-- Baris 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="q" android:tag="q" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="w" android:tag="w" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="e" android:tag="e" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="r" android:tag="r" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="t" android:tag="t" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="y" android:tag="y" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="u" android:tag="u" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="i" android:tag="i" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="o" android:tag="o" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="p" android:tag="p" />
    </LinearLayout>

    <!-- Baris 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="a" android:tag="a" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="s" android:tag="s" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="d" android:tag="d" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="f" android:tag="f" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="g" android:tag="g" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="h" android:tag="h" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="j" android:tag="j" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="k" android:tag="k" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="l" android:tag="l" />
    </LinearLayout>

    <!-- Baris 3: shift - huruf - hapus -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button style="@style/KeyButton.Function" android:layout_weight="1.5" android:text="↑" android:tag="shift" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="z" android:tag="z" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="x" android:tag="x" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="c" android:tag="c" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="v" android:tag="v" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="b" android:tag="b" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="n" android:tag="n" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="m" android:tag="m" />
        <Button style="@style/KeyButton.Function" android:layout_weight="1.5" android:text="⌫" android:tag="backspace" />
    </LinearLayout>

    <!-- Baris 4: angka - spasi - return -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button style="@style/KeyButton.Function" android:layout_weight="2" android:text="123" android:tag="to_symbols" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="6" android:text="" android:tag="space" />
        <Button style="@style/KeyButton.Function" android:layout_weight="2" android:text="return" android:tag="enter" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Halaman simbol lanjutan (tombol #+=): kurung, persen, panah, mata uang. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#D1D4DA"
    android:padding="3dp">

    <!-- Baris 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="[" android:tag="[" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="]" android:tag="]" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="{" android:tag="{" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="}" android:tag="}" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="#" android:tag="#" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="%" android:tag="%" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="^" android:tag="^" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="*" android:tag="*" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="+" android:tag="+" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="=" android:tag="=" />
    </LinearLayout>

    <!-- Baris 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="_" android:tag="_" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="\" android:tag="\" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="|" android:tag="|" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="~" android:tag="~" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="&lt;" android:tag="&lt;" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text=">" android:tag=">" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="€" android:tag="€" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="£" android:tag="£" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="¥" android:tag="¥" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="•" android:tag="•" />
    </LinearLayout>

    <!-- Baris 3: balik angka - titik/koma - hapus -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button style="@style/KeyButton.Function" android:layout_weight="1.5" android:text="123" android:tag="to_symbols" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="." android:tag="." />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="," android:tag="," />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="?" android:tag="?" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="!" android:tag="!" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="1" android:text="'" android:tag="'" />
        <Button style="@style/KeyButton.Function" android:layout_weight="1.5" android:text="⌫" android:tag="backspace" />
    </LinearLayout>

    <!-- Baris 4: huruf - spasi - return -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button style="@style/KeyButton.Function" android:layout_weight="2" android:text="ABC" android:tag="to_letters" />
        <Button style="@style/KeyButton.Letter" android:layout_weight="6" android:text="" android:tag="space" />
        <Button style="@style/KeyButton.Function" android:layout_weight="2" android:text="return" android:tag="enter" />
    </LinearLayout>
</LinearLayout>

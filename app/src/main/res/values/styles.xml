<?xml version="1.0" encoding="utf-8"?>
<!-- Gaya tombol terpusat supaya 60+ tombol tidak ditulis berulang.
     Huruf = putih teks besar, fungsi = abu-abu teks kecil. -->
<resources>
    <style name="KeyButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="KeyButton.Letter" parent="KeyButton">
        <item name="android:background">@drawable/key_letter</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="KeyButton.Function" parent="KeyButton">
        <item name="android:background">@drawable/key_function</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
